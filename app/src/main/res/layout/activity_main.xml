<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    The Activity hosts a single Fragment (MainActivityFragment), exactly as
    described in Chapter 6 of the book. The padding attributes of the default
    layout were removed so the game fills the whole screen.
-->
<fragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment"
    android:name="com.pedrou.cannongame.MainActivityFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:layout="@layout/fragment_main" />
