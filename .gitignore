# ---------------------------------------------------------------------------
# Cannon Game - .gitignore (Android / Gradle / Android Studio)
# ---------------------------------------------------------------------------

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (Android SDK path, etc.)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# Google Services
google-services.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Project-specific exclusions
# ---------------------------------------------------------------------------

# PDFs (material de estudo) nao fazem parte do codigo-fonte do aplicativo.
*.pdf
